# Copy to .env and set as needed

# OpenAI API key (for prompt refinement and AI image generation).
# If not set, the script will fall back to a generic random wallpaper source.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional: defaults to OPENAI_TEXT_MODEL for visual QA of generated images.
OPENAI_QA_MODEL=

# Image provider toggle
# Options:
#   openai   - use OpenAI image generation (requires OPENAI_API_KEY)
#   fallback - use generic random wallpaper sources (no AI)
# Default is openai.
IMAGE_PROVIDER=openai

# Desktop environment: cinnamon | gnome
# Defaults to cinnamon on Linux Mint
DESKTOP_ENV=cinnamon

# Output directory for generated wallpapers
OUTPUT_DIR=output

# Optional: restrict run to a topic
# Example: FOCUS="sports" or FOCUS="european rap"
# Note: CLI flags -focus/--focus/-f override this env var
FOCUS=

# Optional: print contributing headlines during manual runs
RUN_VERBOSE=false
